---
 crates/tauri-bundler/src/bundle/settings.rs | 43 +++++++++++++++++++--
 crates/tauri-cli/src/runtime/electron.rs    | 27 +++++++++++++
 crates/tauri-cli/src/runtime/mod.rs         | 21 +++++++---
 3 files changed, 82 insertions(+), 9 deletions(-)
