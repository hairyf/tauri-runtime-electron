@@ -127,7 +132,7 @@ impl Runtime {
   pub fn macos_dev_in_app_bundle(self) -> bool {
     match self {
       Self::Cef => true,
-      Self::Wry | Self::Other => false,
+      Self::Wry | Self::Electron | Self::Other => false,
