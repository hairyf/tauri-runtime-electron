--- a/crates/tauri-bundler/src/bundle/settings.rs
+++ b/crates/tauri-bundler/src/bundle/settings.rs
@@ -675,6 +675,19 @@ pub enum WebviewRuntime {
   },
   /// A runtime the bundler has no specific support for; nothing runtime-specific is shipped.
   Other,
+  /// Electron, shipped with the application.
+  ///
+  /// The runtime's build script prepares one directory holding the Electron
+  /// distribution, the JavaScript bridge and the version markers; the bundler
+  /// copies it whole into the bundle's resource directory, which is where the
+  /// runtime looks for it at launch.
+  Electron {
+    /// The prepared distribution to copy into the bundle.
+    ///
+    /// `None` for an application on a shared runtime, which finds Electron outside
+    /// its bundle: nothing of the distribution ships.
+    distribution: Option<PathBuf>,
+  },
 }
 
 impl WebviewRuntime {
@@ -684,7 +697,7 @@ impl WebviewRuntime {
   pub fn uses_webview2(&self) -> bool {
     match self {
       Self::Wry => true,
-      Self::Cef { .. } | Self::Other => false,
+      Self::Cef { .. } | Self::Electron { .. } | Self::Other => false,
     }
   }
 
@@ -695,7 +708,15 @@ impl WebviewRuntime {
         distribution,
         helper: _,
       } => distribution.as_deref(),
-      Self::Wry | Self::Other => None,
+      Self::Wry | Self::Electron { .. } | Self::Other => None,
+    }
+  }
+
+  /// The Electron distribution to copy into the bundle, when the application embeds Electron.
+  pub fn electron_distribution(&self) -> Option<&Path> {
+    match self {
+      Self::Electron { distribution } => distribution.as_deref(),
+      Self::Wry | Self::Cef { .. } | Self::Other => None,
     }
   }
 
@@ -706,7 +727,7 @@ impl WebviewRuntime {
         distribution: _,
         helper,
       } => helper.as_ref(),
-      Self::Wry | Self::Other => None,
+      Self::Wry | Self::Electron { .. } | Self::Other => None,
     }
   }
 }
@@ -1309,7 +1330,21 @@ impl Settings {
       let dest = path.join(resource.target());
       fs_utils::copy_file(resource.path(), &dest)?;
     }
-    Ok(())
+    self.copy_electron_distribution(path)
+  }
+
+  /// Copies the Electron distribution into `resources_dir/electron`.
+  ///
+  /// The runtime looks for it there at launch, so the application never has to
+  /// declare a `bundle > resources` entry: the runtime crate's build script
+  /// prepared the directory and the CLI resolved it, which is the same contract
+  /// that lets a CEF application ship its framework without configuration.
+  fn copy_electron_distribution(&self, resources_dir: &Path) -> crate::Result<()> {
+    let Some(distribution) = self.webview_runtime().electron_distribution() else {
+      return Ok(());
+    };
+    let destination = resources_dir.join("electron");
+    fs_utils::copy_dir(distribution, &destination)
   }
 
   /// Returns the version string of the bundle.
diff --git a/crates/tauri-cli/src/runtime/electron.rs b/crates/tauri-cli/src/runtime/electron.rs
new file mode 100644
index 000000000..76559f23c
--- /dev/null
+++ b/crates/tauri-cli/src/runtime/electron.rs
@@ -0,0 +1,27 @@
+// Copyright 2019-2024 Tauri Programme within The Commons Conservancy
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-License-Identifier: MIT
+
+//! Locating the Electron distribution a `tauri-runtime-electron` application ships.
+//!
+//! The runtime's build script prepares the distribution and reports it as
+//! `cargo:electron_dir=…`, which cargo exposes to the application's build script as
+//! `DEP_TAURI_RUNTIME_ELECTRON_ELECTRON_DIR`. The bundler copies that directory
+//! into the bundle's resource directory, which is where the runtime looks for it at
+//! launch — so an application never has to declare a `bundle > resources` entry.
+
+use std::path::PathBuf;
+
+/// The `tauri-runtime-electron` crate.
+pub const CRATE_NAME: &str = "tauri-runtime-electron";
+
+/// The distribution directory the runtime's build script prepared for this build.
+///
+/// `None` when the application was built without the runtime's build script
+/// running — a shared-runtime build, where the distribution is installed
+/// separately and nothing of it ships.
+pub(crate) fn electron_distribution() -> Option<PathBuf> {
+  std::env::var_os("DEP_TAURI_RUNTIME_ELECTRON_ELECTRON_DIR")
+    .map(PathBuf::from)
+    .filter(|path| path.is_dir())
+}
