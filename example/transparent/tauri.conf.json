{
  "productName": "Transparent Window",
  "version": "0.1.0",
  "identifier": "com.tauri.runtime-electron.transparent",
  "build": {
    "frontendDist": ["index.html", "style.css", "main.js", "window-api.js"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Transparent Window",
        "width": 760,
        "height": 560,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        {
          "identifier": "transparent-window",
          "windows": ["main"],
          "permissions": ["core:window:allow-start-dragging", "core:window:allow-minimize", "core:window:allow-close", "electron-window:allow-set-effects"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../.icons/icon.ico", "../.icons/icon.png"]
  }
}
